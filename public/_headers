/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src https:; frame-ancestors 'self'

# Το «Ράψε πάνω του» του beat store χρειάζεται μικρόφωνο, μόνο σε αυτή τη σελίδα.
/beats
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()


/beats/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/en/beats
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/en/beats/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# Τα js/css του build έχουν hash στο όνομα: δεν αλλάζουν ποτέ, άρα cache για πάντα.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable
